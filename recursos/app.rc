// Recursos do Windows embutidos no EngLaTeX.exe: ícone, manifesto e versão.
1 ICON "icone.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "Eng LaTeX - editor LaTeX offline"
      VALUE "ProductName", "Eng LaTeX"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductVersion", "1.2.0"
      VALUE "OriginalFilename", "EngLaTeX.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
