{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.invalid/contracts/project-archive/v1/forge-project.schema.json",
  "title": "FORGE Project Archive Manifest",
  "description": "Proposta v1 de manifesto para arquivo ZIP de intercâmbio FORGE; não aprovada.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "project",
    "files"
  ],
  "properties": {
    "format": {
      "const": "forge-project"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "entryFile",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "entryFile": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "mediaType",
          "encoding",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "enum": [
              "utf-8",
              "binary"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
